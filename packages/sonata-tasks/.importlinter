[importlinter]
root_packages =
    sonata_tasks
    sonata_engine
include_external_packages = True

[importlinter:contract:engine_does_not_import_catalogue]
name = sonata-engine must not import sonata-tasks
type = forbidden
source_modules = sonata_engine
forbidden_modules = sonata_tasks

[importlinter:contract:catalogue_does_not_import_products]
name = sonata-tasks must not import downstream products
type = forbidden
source_modules = sonata_tasks
forbidden_modules =
    nanolab
    tui_toolkit
